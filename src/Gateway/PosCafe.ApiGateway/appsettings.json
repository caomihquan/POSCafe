{
  "ReverseProxy": {
    "Routes": {
      "identity-register": { "ClusterId": "identity", "Match": { "Path": "/identity/register" } },
      "identity-login": { "ClusterId": "identity", "Match": { "Path": "/identity/login" } },
      "identity-refresh": { "ClusterId": "identity", "Match": { "Path": "/identity/refresh" } },
      "identity-logout": { "ClusterId": "identity", "Match": { "Path": "/identity/logout" } },
      "identity-protected": { "ClusterId": "identity", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/identity/{**catch-all}" } },
      "catalog": { "ClusterId": "catalog", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/api/v1/catalog/{**catch-all}" } },
      "orders": { "ClusterId": "order", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/api/v1/orders/{**catch-all}" } },
      "payments": { "ClusterId": "payment", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/api/v1/payments/{**catch-all}" } },
      "inventory": { "ClusterId": "inventory", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/api/v1/inventory/{**catch-all}" } },
      "stores": { "ClusterId": "store", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/api/v1/stores/{**catch-all}" } },
      "reports": { "ClusterId": "reporting", "AuthorizationPolicy": "authenticated", "Match": { "Path": "/api/v1/reports/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://identity" } } },
      "catalog": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://catalog" } } },
      "order": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://order" } } },
      "payment": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://payment" } } },
      "inventory": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://inventory" } } },
      "store": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://store" } } },
      "reporting": { "HttpClient": { "MaxConnectionsPerServer": 100 }, "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "primary": { "Address": "http://reporting" } } }
    }
  },
  "Dlq": {
    "ReplayHistory": {
      "RetentionDays": 90,
      "IntervalHours": 24,
      "BatchSize": 1000
      ,"PendingMaxAgeMinutes": 10
    }
  },
  "Security": {
    "RateLimit": {
      "DlqPermitLimit": 30,
      "DlqWindowSeconds": 60
    }
  },
  "Audit": {
    "RetentionDays": 365,
    "IntervalHours": 24,
    "BatchSize": 1000,
    "Archive": {
      "Enabled": false,
      "ContainerName": "audit-archive"
    },
    "RetentionMaxAgeDays": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*"
}
