{
  "Messaging": { "RequiredTopics": ["pos.order.events", "pos.order.events.dlq"], "MinimumTopicPartitions": 1 },
  "Audit": { "RetentionDays": 365, "IntervalHours": 24, "Archive": { "Enabled": false, "ContainerName": "audit-archive" } },
  "Outbox": {
    "Order": {
      "Topic": "pos.order.events",
      "BatchSize": 50,
      "MaxAttempts": 10,
      "LeaseSeconds": 60,
      "PollSeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
