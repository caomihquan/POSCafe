{
  "Messaging": { "RequiredTopics": ["pos.order.events", "pos.payment.events", "pos.payment.order-events.dlq"], "MinimumTopicPartitions": 1 },
  "Audit": { "RetentionDays": 365, "IntervalHours": 24, "Archive": { "Enabled": false, "ContainerName": "audit-archive" } },
  "Outbox": {
    "Payment": {
      "Topic": "pos.payment.events",
      "InputTopic": "pos.order.events",
      "ConsumerGroup": "pos-payment-order-events-v1",
      "BatchSize": 50,
      "MaxAttempts": 10,
      "LeaseSeconds": 60,
      "PollSeconds": 5,
      "ConsumerRetrySeconds": 5,
      "ConsumerMaxAttempts": 5,
      "RetryMaxSeconds": 300,
      "DeadLetterTopic": "pos.payment.order-events.dlq"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
