{
  "Messaging": { "RequiredTopics": ["pos.order.events", "pos.inventory.events", "pos.inventory.order-events.dlq", "pos.inventory.events.dlq"], "MinimumTopicPartitions": 1 },
  "Audit": { "RetentionDays": 365, "IntervalHours": 24, "Archive": { "Enabled": false, "ContainerName": "audit-archive" } },
  "Inventory": {
    "Messaging": {
      "InputTopic": "pos.order.events",
      "ConsumerGroup": "pos-inventory-order-events-v1",
      "ConsumerRetrySeconds": 5,
      "ConsumerMaxAttempts": 5,
      "RetryMaxSeconds": 300,
      "DeadLetterTopic": "pos.inventory.order-events.dlq"
    }
  },
  "Outbox": {
    "Inventory": {
      "Topic": "pos.inventory.events",
      "BatchSize": 50,
      "MaxAttempts": 10,
      "LeaseSeconds": 60,
      "PollSeconds": 5,
      "DeadLetterTopic": "pos.inventory.events.dlq"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
